# Chaves e segredos (as chaves reais ficam em .env — ver .env.example)
.env
.env.local
*.key

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Dados pesados e cache
data/cache/
data/raw/
# Excel brutos do Terminal Bloomberg: não redistribuíveis (licença Bloomberg).
# O CSV parseado é regenerável via scripts/unificar_bloomberg.py.
data/bloomberg/raw/*.xlsx
# Backups do CSV parseado: mesmo conteúdo Bloomberg, mesma restrição.
*.csv.bak
data/cvm/raw/*.zip
data/cvm/raw/cad_cia_aberta.csv
data/cvm/processed/
*.csv
!data/bloomberg/*.csv
*.parquet

# Saídas do backtest
backtest/reports/*.png
backtest/reports/*.html

# Documento de estratégia (mantido fora do repositório público)
/jempo_estrategia_final.pdf

# Sistema
.DS_Store
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Relatórios/resumos de revisão (mantidos locais, fora do repo)
RELATORIO_*.md
RESUMO_*.md
# Exceção: relatório oficial de calibração do MATH&ML é entregável versionado
!calibration/results/RELATORIO_CALIBRACAO_MATHML.md
# Exceção: relatório oficial do gate de custo Haiku vs Sonnet é entregável versionado
!calibration/results/RELATORIO_GATE_CUSTO.md
# Exceção: relatório oficial da calibração do ECON é entregável versionado
!calibration/results/RELATORIO_CALIBRACAO_ECON.md

# Saídas transitórias de debug
*.log
/saida.txt
scripts/debug_*.py

# Ferramenta graphify (grafo de conhecimento local — cache regenerável +
# config/hooks pessoais; não versionado para não forçar a ferramenta a quem clona)
graphify-out/
.claude/
CLAUDE.md

# Relatórios em PDF (mantidos locais, fora do repo — mesma política dos RELATORIO_*.md)
RELATORIO_*.pdf
